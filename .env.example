# Copy to .env and adjust. Never commit .env.

POSTGRES_USER=testplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=testplace
# Host port exposed by docker compose for local development.
POSTGRES_PORT=5432

# Used by the API when it runs outside docker compose (npm run dev:api, prisma migrate).
DATABASE_URL=postgresql://testplace:change-me@localhost:5432/testplace

PORT=3000
