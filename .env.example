# Copy to .env and adjust. Never commit .env.

POSTGRES_USER=testplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=testplace
# Host port exposed by docker compose for local development.
POSTGRES_PORT=5432

# Used by the API when it runs outside docker compose (npm run dev:api, prisma migrate).
DATABASE_URL=postgresql://testplace:change-me@localhost:5432/testplace
# Wiped by the integration tests (npm run test:int). Its name must contain "test".
TEST_DATABASE_URL=postgresql://testplace:change-me@localhost:5432/testplace_test

PORT=3000
# Interface the API listens on. Defaults to 127.0.0.1; the Docker image uses 0.0.0.0.
# HOST=127.0.0.1

# "dev" attributes every request to a fixed administrator. Refused when NODE_ENV=production.
AUTH_MODE=dev

# Import limits (defaults shown).
# IMPORT_MAX_ARCHIVE_BYTES=5242880
# IMPORT_MAX_UNCOMPRESSED_BYTES=20971520
# IMPORT_MAX_FILES=1000

# Share of Blocked cases above which a closed campaign is flagged "à rejouer" (EF-09).
# CAMPAIGN_REPLAY_THRESHOLD=0.1
