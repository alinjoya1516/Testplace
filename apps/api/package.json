{
  "name": "@testplace/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --path tsconfig.dev.json",
    "start:prod": "node dist/main",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js -c jest.int.config.ts",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/serve-static": "^12.0.0",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@testplace/shared": "0.0.0",
    "fflate": "^0.8.3",
    "prisma": "~7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.0.0",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  }
}
